{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "edge",
	"description": "Permissions of the Edge window alone: its global shortcuts, and api.fetch for its widgets (any http or https URL)",
	"windows": ["edge"],
	"permissions": [
		"global-shortcut:allow-register",
		"global-shortcut:allow-unregister-all",
		{
			"identifier": "http:default",
			"allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
		}
	]
}
