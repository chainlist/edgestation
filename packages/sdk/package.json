{
	"name": "@edgestation/sdk",
	"version": "0.8.0",
	"description": "Types and build helpers to write widgets for EdgeStation, the secondary display dashboard made for the Corsair Xeneon Edge, in plain JavaScript, Svelte, React or Vue.",
	"keywords": [
		"edgestation",
		"widget",
		"dashboard",
		"secondary-display",
		"xeneon-edge"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chainlist/edgestation.git",
		"directory": "packages/sdk"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./svelte": "./src/svelte.ts",
		"./react": "./src/react.ts",
		"./vue": "./src/vue.ts",
		"./vite": "./src/vite.ts",
		"./manifest.schema.json": "./manifest.schema.json"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./svelte": {
				"types": "./dist/svelte.d.ts",
				"default": "./dist/svelte.js"
			},
			"./react": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			},
			"./vue": {
				"types": "./dist/vue.d.ts",
				"default": "./dist/vue.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./manifest.schema.json": "./manifest.schema.json"
		}
	},
	"files": [
		"dist",
		"manifest.schema.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"check": "tsc -p tsconfig.json",
		"test": "vitest --run"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"svelte": "^5",
		"vite": ">=6",
		"vue": "^3.3"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"ajv": "^8.20.0",
		"happy-dom": "^21.0.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"svelte": "^5.57.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vue": "^3.5.45"
	}
}
