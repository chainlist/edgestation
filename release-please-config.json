				{ "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "apps/desktop/tauri.conf.json", "jsonpath": "$.version" },
				{ "type": "toml", "path": "apps/desktop/Cargo.toml", "jsonpath": "$.package.version" },
				{
					"type": "toml",
					"path": "apps/desktop/Cargo.lock",
					"jsonpath": "$.package[?(@.name.value==='edgestation')].version"
				},
				"apps/web/src/lib/site.ts",
				"apps/web/src/lib/docs/pages/dependencies.md"
			]
		}
	}
}
